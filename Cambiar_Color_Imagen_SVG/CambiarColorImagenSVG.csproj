<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Cambiar_Color_Imagen_SVG</RootNamespace>
    <AssemblyName>Imagen SVG</AssemblyName>
    <ApplicationIcon>Cambiar color Imagen SVG.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Reemplaza las llamadas manuales de Program.Main via ApplicationConfiguration.Initialize().
         DpiUnaware conserva el comportamiento de escalado que tenia el proyecto en .NET Framework 4.6. -->
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
    <!-- El formulario se diseno con AutoScaleDimensions (6,13), que corresponde a la
         fuente por defecto de .NET Framework (Microsoft Sans Serif 8.25pt). .NET moderno
         usa Segoe UI 9pt = (7,15), lo que escalaba toda la interfaz un 16% respecto al
         diseno original (el MinimumSize de 800 se volvia 931). -->
    <ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Cambiar_Color_Imagen_SVG</Product>
    <AssemblyTitle>Cambiar_Color_Imagen_SVG</AssemblyTitle>
    <Copyright>Copyright © 2021</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Guna.UI2.WinForms" Version="2.0.4.8" />
    <PackageReference Include="Svg" Version="3.4.7" />
  </ItemGroup>

</Project>
