<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!--
    Los tres valores de Identity y PublisherDisplayName salen de Partner Center:
    Product management -> Product identity. Tienen que coincidir exactamente o la
    subida se rechaza.

    El cuarto numero de Version debe ser siempre 0 para la Store (1.0.0.0 sirve,
    1.0.0.1 no). Hay que subirlo en cada envio nuevo.
  -->
  <Identity Name="JuanDiegoWS.EditordeColoresSVG"
            Publisher="CN=B54DDA08-C189-43DE-B136-A6406F42BCE2"
            Version="1.1.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Editor de Colores SVG</DisplayName>
    <PublisherDisplayName>JuanDiegoWS</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-co" />
  </Resources>

  <Applications>
    <Application Id="EditorColoresSVG" Executable="Imagen SVG.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Editor de Colores SVG"
        Description="Reemplaza los colores de una imagen SVG y la exporta como SVG, PNG, JPG o BMP."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <!-- Obligatoria para una aplicacion de escritorio Win32 empaquetada en MSIX. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
